{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "ShellFlow: Run site (rebuild on save)",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/dev.js",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "name": "ShellFlow: Run site only",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/server.js",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "name": "ShellFlow: Run tests",
      "type": "node",
      "request": "launch",
      "runtimeArgs": ["--test", "test/api.test.js"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"]
    }
  ]
}
