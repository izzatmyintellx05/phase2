# Copy this file to .env for local running. On a host, set these in its settings screen.
# Never commit your real .env file or share these values by email.

# Required in production. A long random value, at least 32 characters.
# Make one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# The first administrator, created the first time the site starts. They must choose a new
# password at first sign-in. After that you can remove ADMIN_PASSWORD from the settings.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# PostgreSQL address, for example from Supabase. Required on Vercel.
# Left blank, data is kept in the data/ folder, which suits one server with a lasting disk.
DATABASE_URL=

# Optional. The hosted database's CA certificate, to turn on full certificate checks.
DATABASE_CA_CERT=

# Optional. Keeps the page on a fixed date, so the sample data's timers tell the same story.
# Leave it blank to use the real date.
DEMO_DATE=2026-11-18

# Optional. The port for local running or Docker.
PORT=3000
